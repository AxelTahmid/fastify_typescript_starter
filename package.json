{
    "name": "fastifystarter",
    "version": "2.0.0",
    "description": "Fastify starter template with TypeScript, Kysely, pg-boss, and Docker tooling",
    "type": "module",
    "author": "AxelTahmid",
    "license": "Apache-2.0",
    "packageManager": "yarn@4.9.1",
    "engines": {
        "node": ">=24.0.0"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "start": "npx tsx src/server.ts",
        "dev": "npx tsx watch --clear-screen=false src/server.ts",
        "test": "yarn build && node --test --test-isolation=none \"dist/**/*.test.js\"",
        "migrate": "make db-migrate",
        "seed": "npx tsx src/database/seed-acl.ts && npx tsx src/database/seed-admin.ts",
        "db:types": "make db-types",
        "check": "yarn exec biome check .",
        "format": "yarn exec biome check --write .",
        "deps": "yarn upgrade-interactive",
        "release": "standard-version"
    },
    "dependencies": {
        "@fastify/basic-auth": "^6.2.0",
        "@fastify/cookie": "^11.0.2",
        "@fastify/cors": "^11.3.0",
        "@fastify/formbody": "^8.0.2",
        "@fastify/helmet": "^13.1.0",
        "@fastify/jwt": "^10.2.0",
        "@fastify/multipart": "^10.1.0",
        "@fastify/sensible": "^6.0.4",
        "@fastify/swagger": "^9.8.1",
        "@fastify/under-pressure": "^9.1.0",
        "@scalar/fastify-api-reference": "^1.62.8",
        "argon2": "^0.44.0",
        "close-with-grace": "^2.5.0",
        "dotenv": "^17.4.2",
        "fastify": "^5.10.0",
        "fastify-plugin": "^6.0.0",
        "kysely": "^0.29.3",
        "minio": "^8.0.7",
        "nodemailer": "^9.0.3",
        "ofetch": "^1.5.1",
        "pg": "^8.22.0",
        "pg-boss": "^12.26.0",
        "typebox": "^1.3.6"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.4",
        "@fastify/type-provider-typebox": "^6.1.0",
        "@types/node": "^25.9.5",
        "@types/nodemailer": "^8.0.1",
        "@types/pg": "^8.20.0",
        "kysely-codegen": "^0.20.0",
        "lefthook": "^2.1.10",
        "pino-pretty": "^13.1.3",
        "standard-version": "^9.5.0",
        "tsc-alias": "^1.9.1",
        "tsx": "^4.23.1",
        "typescript": "^6.0.3"
    }
}
