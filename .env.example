# ─────────────────────────────────────────────────────────────────────────
# Environment — validated at boot against src/config/env.ts (TypeBox).
# A malformed value stops the server with a readable error.
# In production, secrets marked [prod-required] hard-fail when missing.
# ─────────────────────────────────────────────────────────────────────────

NODE_ENV=development

HOST=0.0.0.0
PORT=3000

# ── Database ──────────────────────────────────────────────────────────────
DB_NAME=starterdb
DB_USER=starteruser
DB_PASSWORD=starterpass          # [prod-required] unless a connection string is set
DB_HOST=db
DB_PORT=5432
DB_APP_NAME=fastify-starter
DB_TIMEZONE=UTC
PG_CONNECTION_STRING=postgres://starteruser:starterpass@db:5432/starterdb

DB_POOL_MIN=1
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=10000
DB_POOL_CONNECTION_TIMEOUT=5000
DB_QUERY_TIMEOUT=30000
DB_LOCK_TIMEOUT=5000
DB_STATEMENT_TIMEOUT=30000
DB_KEEP_ALIVE_INITIAL_DELAY=30000
DB_IDLE_IN_TRANSACTION_SESSION_TIMEOUT=30000

# ── Queue (pg-boss) ───────────────────────────────────────────────────────
PGBOSS_APP_NAME=starter-queue
PGBOSS_SCHEMA=queue
PGBOSS_MIGRATE=true
PGBOSS_MAX_CONN=5
PGBOSS_ARCHIVE_COMPLETED_AFTER=43200
PGBOSS_ARCHIVE_FAILED_AFTER=43200
PGBOSS_DELETE_AFTER_DAYS=7
PGBOSS_MONITOR_INTERVAL=5

# ── Object storage (MinIO / any S3-compatible) ────────────────────────────
# S3_ENDPOINT is what the API container reaches; S3_PUBLIC_ENDPOINT is what
# browsers reach — presigned upload URLs are rewritten to the public one.
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=starter
S3_ACCESS_KEY=minioadmin         # [prod-required]
S3_SECRET_PASSWORD=minioadmin    # [prod-required]

# ── Mailer (mailpit in dev — UI at http://localhost:8025) ─────────────────
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_POOL=false
SMTP_MAX_CONNECTIONS=5
SMTP_MAX_MESSAGES=100
SMTP_CONNECTION_TIMEOUT=120000
SMTP_SOCKET_TIMEOUT=600000
SMTP_TLS_REJECT_UNAUTHORIZED=false
MAILER_DEFAULT_FROM=Starter <no-reply@example.com>
MAILER_DEFAULT_SUBJECT=Starter Notification
MAILER_DEFAULT_REPLY_TO=
MAILER_DEFAULT_PRIORITY=normal

# ── Auth ──────────────────────────────────────────────────────────────────
# Access tokens are short-lived and carry permissions; refresh tokens ride
# an httpOnly cookie and are revocable. Generate keys with: make jwt
AUTH_ACCESS_TOKEN_TTL=600
AUTH_REFRESH_TOKEN_TTL=21600
AUTH_REFRESH_COOKIE_NAME=starter_refresh
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ── Seed (make db-seed / db-reset) ────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme-admin-password   # [prod-required]

# ── Server tuning ─────────────────────────────────────────────────────────
SERVER_KEEP_ALIVE_TIMEOUT=60000
SERVER_REQUEST_TIMEOUT=30000
SERVER_BODY_LIMIT=5242880

# TLS (optional — enables HTTP/2; generate with: make tls)
SERVER_TLS_CERT=
SERVER_TLS_KEY=

# ── OpenAPI docs (dev-only, basic-auth at /openapi) ───────────────────────
OPENAPI_USER=root
OPENAPI_PASS=root

# ── Healthcheck (under-pressure) ──────────────────────────────────────────
MAX_EVENT_LOOP_DELAY=1000
MAX_EVENT_LOOP_UTILIZATION=0.9
UNDER_PRESSURE_MESSAGE=Server under pressure!
RETRY_AFTER=60
